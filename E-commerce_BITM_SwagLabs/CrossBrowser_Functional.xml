<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="CrossBrowser_Functional">

    <test name="Chrome_Functional">
        <parameter name="browser" value="chrome"/>
        <groups>
            <run>
                <include name="functional"/>
            </run>
        </groups>
        <packages>
            <package name="ecomSwagLabsLogin"/>
            <package name="ecomSwagLabsHome"/>
            <package name="ecomSwagLabsCart"/>
            <package name="ecomSwagLabsCheckout"/>
            <package name="ecomSwagLabsDynamicCatalog"/>
        </packages>
    </test>

    <test name="Edge_Functional">
        <parameter name="browser" value="edge"/>
        <groups>
            <run>
                <include name="functional"/>
            </run>
        </groups>
        <packages>
            <package name="ecomSwagLabsLogin"/>
            <package name="ecomSwagLabsHome"/>
            <package name="ecomSwagLabsCart"/>
            <package name="ecomSwagLabsCheckout"/>
            <package name="ecomSwagLabsDynamicCatalog"/>
        </packages>
    </test>

    <test name="Firefox_Functional">
        <parameter name="browser" value="firefox"/>
        <groups>
            <run>
                <include name="functional"/>
            </run>
        </groups>
        <packages>
            <package name="ecomSwagLabsLogin"/>
            <package name="ecomSwagLabsHome"/>
            <package name="ecomSwagLabsCart"/>
            <package name="ecomSwagLabsCheckout"/>
            <package name="ecomSwagLabsDynamicCatalog"/>
        </packages>
    </test>

</suite>